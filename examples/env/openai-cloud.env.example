# OpenAI cloud example: GPT-6 Luna for the LLM and OpenAI embeddings for the
# bi-encoder, with no cross-encoder.
#
# This tracked file is a template only. Copy it to the ignored .env file at the
# repository root, replace every placeholder there, and never commit that file.
# The same OpenAI key is used for both API calls; the project-specific variable
# names are what the CLI reads.

NEXUS_BASE_DIR=/path/to/ai-atlas-nexus
POLICY_MAPPER_BASE_URL=https://api.openai.com/v1
POLICY_MAPPER_MODEL=gpt-6-luna
POLICY_MAPPER_API_KEY=replace-with-openai-api-key
POLICY_MAPPER_BI_ENCODER_API_KEY=replace-with-openai-api-key
POLICY_MAPPER_BI_ENCODER_MODEL=https://api.openai.com/v1
POLICY_MAPPER_BI_ENCODER_MODEL_NAME=text-embedding-3-large
# Unused by the command below because it disables cross-encoder reranking.
# POLICY_MAPPER_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
POLICY_MAPPER_MAX_OUTPUT_TOKENS=8192
POLICY_MAPPER_OUTPUT_TOKEN_PARAMETER=max_completion_tokens

# From the repository root, copy and edit the template once if .env does not
# already exist. If it does exist, merge these settings into it instead of
# overwriting it:
# cp examples/env/openai-cloud.env.example .env
#
# Then run from the repository root:
# uv run --env-file .env \
#   asago-policy-mapper extract policy.pdf -o output/ \
#   --temperature 1.0 \
#   --no-cross-encoder \
#   --query-instruction ""
