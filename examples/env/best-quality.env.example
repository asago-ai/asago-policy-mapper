# Best-quality example: Qwen3-Embedding-4B plus GTE reranking, both served
# remotely (typically on a GPU cluster).
#
# This tracked file is a template only. Copy it to the ignored .env file at the
# repository root, replace every placeholder there, and never commit that file.

NEXUS_BASE_DIR=/path/to/ai-atlas-nexus
POLICY_MAPPER_BASE_URL=https://llm-serving.example.com/v1
POLICY_MAPPER_MODEL=my-model
POLICY_MAPPER_API_KEY=replace-with-llm-api-key
POLICY_MAPPER_BI_ENCODER_API_KEY=replace-with-embedding-api-key
POLICY_MAPPER_BI_ENCODER_MODEL=https://qwen3-embedding-serving.example.com/v1
POLICY_MAPPER_BI_ENCODER_MODEL_NAME=Qwen3-Embedding-4B
POLICY_MAPPER_CROSS_ENCODER_MODEL=https://gte-reranker-serving.example.com/v1/score
POLICY_MAPPER_MAX_OUTPUT_TOKENS=8192
POLICY_MAPPER_OUTPUT_TOKEN_PARAMETER=max_tokens

# From the repository root, copy and edit the template once if .env does not
# already exist. If it does exist, merge these settings into it instead of
# overwriting it:
# cp examples/env/best-quality.env.example .env
#
# Then run from the repository root:
# uv run --env-file .env \
#   asago-policy-mapper extract policy.pdf -o output/ \
#   --query-instruction "Instruct: Given a text passage from an AI governance policy document, retrieve AI risk descriptions that are relevant to the concepts, requirements, or concerns discussed in the passage\nQuery: " \
#   --expand-siblings
