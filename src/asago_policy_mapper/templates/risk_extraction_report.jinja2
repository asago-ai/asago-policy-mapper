            <button type="button" x-ref="groundingButton" aria-label="Filter by grounding" @click="groundingOpen = !groundingOpen"
                    :aria-expanded="groundingOpen"
                    class="pf-v6-c-button pf-m-control pf-v6-u-display-flex report-min-w-28 pf-v6-u-align-items-center pf-v6-u-justify-content-space-between report-border report-border-default report-rounded pf-v6-u-px-sm pf-v6-u-py-xs pf-v6-u-font-size-xs report-bg-primary pf-v6-u-text-align-start">
              <span x-text="groundingFilterLabel(filterGrounding, data.risks)"></span>
              <span aria-hidden="true" class="pf-v6-u-ml-xs pf-v6-u-text-color-subtle">&#9662;</span>
            </button>
            <div x-show="groundingOpen" x-transition
                 class="report-absolute report-left-0 report-top-full report-z-30 pf-v6-u-mt-xs report-w-48 report-rounded report-border report-border-default report-bg-primary pf-v6-u-p-xs pf-v6-u-box-shadow-lg"
                 role="group" aria-label="Grounding">
