                <input type="checkbox" :checked="filterGrounding.length === 0 || filterGrounding.length === groundingOptions(data.risks).length"
                       @change="filterGrounding = []" class="report-rounded report-border-default" />
                <span>All</span>
              </label>
              <div class="pf-v6-u-my-xs report-border-t report-border-default"></div>
