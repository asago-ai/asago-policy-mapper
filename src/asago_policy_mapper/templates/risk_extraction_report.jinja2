<!DOCTYPE html>
<html lang="en" data-default-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Policy risk report · asago</title>
  <style>{{ patternfly_css | safe }}</style>
  {% include "report_utilities.html" %}
  <style>
    .pf-v6-theme-dark { color-scheme: dark; }
    [x-cloak] { display: none !important; }

    /* Legacy help labels share one viewport-positioned tooltip. */
    .tip {
      display: inline-block;
      cursor: help;
      border-bottom: 1px dotted #9ca3af;
    }
    .tip:focus-visible { outline: 2px solid #2d7ff9; outline-offset: 3px; }
    .report-hover-tooltip {
      position: fixed;
      z-index: 10000;
      width: max-content;
      max-width: min(320px, calc(100vw - 24px));
      padding: 10px 12px;
      border: 2px solid #2d7ff9;
      border-radius: 8px;
      background: #15243d;
      color: #f9fafb;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.45;
      white-space: normal;
      pointer-events: none;
      text-transform: none;
      letter-spacing: normal;
      box-shadow: 0 12px 28px rgb(0 0 0 / 35%);
    }
    .report-hover-tooltip[hidden] { display: none; }
    .pf-v6-theme-dark .report-hover-tooltip { background: #f9fafb; color: #111827; }

    .tip-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #e5e7eb;
      color: #6b7280;
      font-size: 10px;
      font-weight: 700;
      font-style: normal;
      line-height: 1;
      margin-left: 4px;
      flex-shrink: 0;
      cursor: help;
      vertical-align: middle;
    }

    /* Chevron transition */
    .chevron { transition: transform 0.2s ease; }

    /* Stage badge */
    .stage-badge {
      display: inline-flex;
      align-items: center;
      padding: 1px 6px;
      border-radius: 3px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Timing bar */
    .timing-bar {
      height: 20px;
      border-radius: 4px;
      transition: width 0.3s ease;
      min-width: 2px;
    }

    /* Keep the table header and expandable risk rows on identical tracks. */
    .risk-table-grid {
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) minmax(11rem, 15rem) 10rem 5rem 1.5rem;
      min-width: 48rem;
      width: 100%;
    }

    .risk-table-grid th { white-space: nowrap; }
    .asago-findings-table thead .risk-table-grid { align-items: center; }
    .asago-findings-table thead th { padding: .875rem .75rem .875rem 0; }
    .asago-findings-table thead th:last-child { padding-right: 0; }
    .asago-findings-table thead th button,
    .asago-findings-table tbody .risk-table-grid > div:first-child > button { padding: 0; }
    [id] { scroll-margin-top: 1.5rem; }
    button:focus-visible, a:focus-visible, summary:focus-visible {
      outline: 2px solid var(--asago-primary, #2d7ff9);
      outline-offset: 3px;
    }
    .chart-bar { transition: width 180ms ease; }
    @media (prefers-reduced-motion: reduce) {
      .chart-bar, .chevron { transition: none; }
    }
  </style>
  {% include "extraction_dark_mode_snippet.html" %}
  {% include "report_branding.html" %}
</head>
<body class="asago-report report-min-h-screen">
<script>const DATA = {{ report_data | tojson }};</script>

<div id="app" x-data="reportApp()" x-cloak>
  <header class="asago-header">
    <div class="report-max-w-screen-xl pf-v6-u-mx-auto pf-v6-u-px-md pf-v6-u-py-lg report-px-6-sm">
      <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-4 pf-v6-u-mb-md">
        <img src="{{ logo_src }}" alt="asago" class="asago-logo" width="1000" height="400" />
        <span class="asago-product pf-v6-u-font-size-xs report-font-semibold report-uppercase report-tracking-widest">Policy mapper</span>
      </div>
      <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap pf-v6-u-align-items-flex-end pf-v6-u-justify-content-space-between report-gap-4">
        <div>
          <h1 class="asago-title pf-v6-u-font-size-3xl report-font-semibold report-tracking-tight">Policy risk report</h1>
          <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-mt-sm report-break-all" x-text="docNames"></p>
        </div>
        <p x-show="data.metadata?.timestamp" class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">
          Analysed <time :datetime="data.metadata?.timestamp" x-text="formatDate(data.metadata?.timestamp)"></time>
        </p>
      </div>
      <nav aria-label="Report sections" class="pf-v6-u-mt-lg pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-6 pf-v6-u-font-size-sm">
        <a href="#summary" class="pf-v6-u-text-color-subtle report-hover-text-white"><span class="asago-nav-number pf-v6-u-mr-xs">01</span> Summary</a>
        <a href="#overview" class="pf-v6-u-text-color-subtle report-hover-text-white"><span class="asago-nav-number pf-v6-u-mr-xs">02</span> Overview</a>
        <a href="#findings" class="pf-v6-u-text-color-subtle report-hover-text-white"><span class="asago-nav-number pf-v6-u-mr-xs">03</span> Findings</a>
      </nav>
    </div>
  </header>

  <main class="report-max-w-screen-xl pf-v6-u-mx-auto pf-v6-u-px-md pf-v6-u-py-xl report-px-6-sm report-space-y-8">
    <!-- 1. Summary: counts of final matches, independent of filters -->
    <section id="summary" aria-labelledby="summary-heading">
      <p class="pf-v6-u-font-size-xs report-font-semibold asago-link report-uppercase report-tracking-wide pf-v6-u-mb-sm">01 / Summary</p>
      <h2 id="summary-heading" class="pf-v6-u-font-size-xl report-font-semibold pf-v6-u-text-color-regular">Your results at a glance</h2>
      <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-mt-sm report-max-w-3xl" x-text="summaryText"></p>
      <div class="pf-v6-u-display-grid report-grid-cols-2 report-grid-cols-4-lg report-gap-4 report-mt-5">
        <div class="pf-v6-c-card asago-summary-card report-rounded-xl report-p-5">
          <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1">
            <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle">Risk matches</p>
            <button type="button" class="tip-icon" aria-label="About risk matches"
                    data-tip="Number of risk entries matched to your policy across all taxonomies. Several entries may describe the same underlying issue.">i</button>
          </div>
          <p class="pf-v6-u-font-size-4xl report-font-semibold pf-v6-u-text-color-regular report-mt-3" x-text="formatNumber(riskCount)"></p>
          <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-sm">Matched taxonomy entries</p>
        </div>
        <div class="pf-v6-c-card asago-summary-card report-rounded-xl report-p-5">
          <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1">
            <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle">Taxonomies represented</p>
            <button type="button" class="tip-icon" aria-label="About taxonomies represented"
                    data-tip="Number of distinct risk taxonomies with at least one match in your policy. A taxonomy is a collection of defined risks.">i</button>
          </div>
          <p class="pf-v6-u-font-size-4xl report-font-semibold pf-v6-u-text-color-regular report-mt-3" x-text="taxonomyCount"></p>
          <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-sm">Frameworks with risk matches</p>
        </div>
        <div class="pf-v6-c-card asago-summary-card asago-summary-high report-rounded-xl report-p-5">
          <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1">
            <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle">High grounding confidence</p>
            <button type="button" class="tip-icon" aria-label="About strong supporting evidence"
                    data-tip="The AI judged that quoted passages in your policy strongly support these risk matches. This count includes matches rated High for grounding confidence.">i</button>
          </div>
          <p class="pf-v6-u-font-size-4xl report-font-semibold asago-success report-mt-3" x-text="formatNumber(highCount)"></p>
          <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-sm">Matches with strong supporting evidence</p>
        </div>
        <div class="pf-v6-c-card asago-summary-card asago-review-card report-relative report-rounded-xl report-p-5 pf-v6-u-text-align-start">
          <button type="button" @click="showReviewMatches()" :disabled="reviewCount === 0"
                  class="report-absolute report-inset-0 report-w-full report-h-full report-rounded-xl report-disabled-cursor-default"
                  aria-label="Review Medium, Low and Ungrounded matches"></button>
          <div class="report-relative pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1"
               @click.self="if (reviewCount > 0) showReviewMatches()">
            <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-status-warning report-pointer-events-none">Review suggested</p>
            <button type="button" class="tip-icon" aria-label="About suggested reviews"
                    data-tip="Matches with Medium or Low evidence support, or where the AI evidence check was skipped. Select the card to view these matches.">i</button>
          </div>
          <p class="report-relative report-pointer-events-none pf-v6-u-font-size-4xl report-font-semibold pf-v6-u-text-color-status-warning report-mt-3" x-text="formatNumber(reviewCount)"></p>
          <p class="report-relative report-pointer-events-none pf-v6-u-font-size-xs pf-v6-u-text-color-status-warning pf-v6-u-mt-sm">Medium, Low or Ungrounded <span x-show="reviewCount > 0" aria-hidden="true">&rarr;</span></p>
        </div>
      </div>
      <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-mt-3">A topic may have matches in several taxonomies. Counts describe matched entries in those taxonomies.</p>
    </section>

    <!-- 2. Overview: full-report distributions, with links to filtering -->
    <section id="overview" aria-labelledby="overview-heading">
      <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap pf-v6-u-align-items-flex-end pf-v6-u-justify-content-space-between report-gap-3 pf-v6-u-mb-md">
        <div>
          <p class="pf-v6-u-font-size-xs report-font-semibold asago-link report-uppercase report-tracking-wide pf-v6-u-mb-sm">02 / Overview</p>
          <h2 id="overview-heading" class="pf-v6-u-font-size-xl report-font-semibold pf-v6-u-text-color-regular">Explore the pattern of matches</h2>
          <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-mt-xs">Select chart categories to filter the findings. Charts show the full report.</p>
        </div>
        <a href="#findings" class="pf-v6-u-font-size-sm report-font-medium asago-link report-hover-underline">View findings &darr;</a>
      </div>
      <div class="pf-v6-u-display-grid report-grid-cols-1 report-grid-cols-3-lg report-gap-5">
        <div id="themes" class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5" aria-labelledby="themes-heading">
          <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1 pf-v6-u-mb-md">
            <h3 id="themes-heading" class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-regular">Risk matches by theme</h3>
            <button type="button" class="tip-icon" aria-label="About risk themes"
                    data-tip="Number of matched risk entries in each theme. A risk can belong to several themes, so counts overlap. Other / not yet grouped contains matches without a supported theme mapping.">i</button>
          </div>
          <div class="report-space-y-2" role="group" aria-label="Filter findings by theme">
            <template x-for="item in themeDistribution" :key="item.id">
              <button type="button" @click="toggleChartFilter('filterThemes', item.id)"
                      :aria-pressed="filterThemes.includes(item.id)"
                      :aria-label="item.label + ': ' + item.count + ' matches'"
                      class="report-w-full pf-v6-u-text-align-start report-rounded-lg report-border pf-v6-u-p-sm"
                      :class="filterThemes.includes(item.id) ? 'asago-selected' : 'report-border-transparent report-hover-bg-secondary'">
                <div class="pf-v6-u-display-flex pf-v6-u-align-items-center pf-v6-u-justify-content-space-between report-gap-3 pf-v6-u-font-size-xs pf-v6-u-mb-sm">
                  <span class="pf-v6-u-text-color-regular" x-text="item.label"></span>
                  <span class="pf-v6-u-text-color-regular report-font-semibold report-tabular-nums" x-text="item.count"></span>
                </div>
                <div class="report-h-2 report-rounded-full report-bg-secondary report-overflow-hidden">
                  <div class="chart-bar report-h-full report-rounded-full asago-chart-bar"
                       :style="'width: ' + (item.count / themeMax * 100) + '%'"></div>
                </div>
              </button>
            </template>
          </div>
          <p x-show="riskCount === 0" class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-py-xl pf-v6-u-text-align-center">No risk matches to group.</p>
        </div>
        <div class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5">
          <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1 pf-v6-u-mb-md">
            <h3 class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-regular">Risk matches by taxonomy</h3>
            <button type="button" class="tip-icon" aria-label="About risk taxonomies"
                    data-tip="Number of matched risk entries from each taxonomy. Related entries in different taxonomies are counted separately.">i</button>
          </div>
          <div class="report-space-y-2" role="group" aria-label="Filter findings by taxonomy">
            <template x-for="item in taxonomyDistribution" :key="item.value">
              <button type="button" @click="toggleChartFilter('filterTaxonomy', item.value)"
                      :aria-pressed="filterTaxonomy.includes(item.value)"
                      :aria-label="taxonomyLabel(item.value) + ': ' + item.count + ' matches'"
                      class="report-w-full pf-v6-u-text-align-start report-rounded-lg report-border pf-v6-u-p-sm"
                      :class="filterTaxonomy.includes(item.value) ? 'asago-selected' : 'report-border-transparent report-hover-bg-secondary'">
                <div class="pf-v6-u-display-flex pf-v6-u-align-items-center pf-v6-u-justify-content-space-between report-gap-3 pf-v6-u-font-size-xs pf-v6-u-mb-sm">
                  <span class="pf-v6-u-text-color-regular report-break-all" x-text="taxonomyLabel(item.value)"></span>
                  <span class="pf-v6-u-text-color-regular report-font-semibold report-tabular-nums" x-text="item.count"></span>
                </div>
                <div class="report-h-2 report-rounded-full report-bg-secondary report-overflow-hidden">
                  <div class="chart-bar report-h-full report-rounded-full asago-chart-bar"
                       :style="'width: ' + (item.count / taxonomyMax * 100) + '%'"></div>
                </div>
              </button>
            </template>
          </div>
          <p x-show="riskCount === 0" class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-py-xl pf-v6-u-text-align-center">No risk matches to summarise.</p>
        </div>
        <div class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5">
          <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1 pf-v6-u-mb-md">
            <h3 class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-regular">Grounding confidence</h3>
            <button type="button" class="tip-icon" aria-label="About grounding confidence"
                    data-tip="How strongly the AI judges quoted passages in your policy to support each risk match. High indicates stronger support than Medium or Low. Ungrounded means the grounding stage was skipped.">i</button>
          </div>
          <div x-show="riskCount > 0" class="pf-v6-u-display-flex report-h-12 report-rounded-lg report-overflow-hidden report-mb-5"
               role="group" aria-label="Grounding confidence distribution">
            <template x-for="item in groundingDistribution.filter(item => item.count > 0)" :key="item.value">
              <button type="button" @click="toggleChartFilter('filterGrounding', item.value)"
                      :aria-pressed="filterGrounding.includes(item.value)"
                      :aria-label="groundingLabel(item.value) + ': ' + item.count + ' matches, ' + matchShare(item.count)"
                      :title="groundingLabel(item.value) + ': ' + item.count + ' matches'"
                      class="grounding-segment report-h-full report-font-semibold pf-v6-u-font-size-sm"
                      :class="groundingBarColor(item.value)"
                      :style="'width: ' + (item.count / riskCount * 100) + '%'">
                <span x-show="item.count / riskCount >= 0.10" x-text="item.count"></span>
              </button>
            </template>
          </div>
          <div class="pf-v6-u-display-grid report-grid-cols-2 report-gap-2 report-mt-5" role="group" aria-label="Filter findings by grounding confidence">
            <template x-for="item in groundingDistribution" :key="item.value">
              <button type="button" @click="toggleChartFilter('filterGrounding', item.value)"
                      :disabled="item.count === 0" :aria-pressed="filterGrounding.includes(item.value)"
                      :aria-label="groundingLabel(item.value) + ': ' + item.count + ' matches'"
                      class="report-rounded-lg report-border report-p-3 pf-v6-u-text-align-start report-disabled-opacity-50 report-disabled-cursor-default"
                      :class="filterGrounding.includes(item.value) ? 'asago-selected' : 'report-border-default report-hover-bg-secondary'">
                <span class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2 pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">
                  <span class="report-w-2 report-h-2 report-rounded-full" :class="groundingBarColor(item.value)" aria-hidden="true"></span>
                  <span x-text="groundingLabel(item.value)"></span>
                </span>
                <span class="pf-v6-u-display-flex pf-v6-u-align-items-baseline pf-v6-u-justify-content-space-between pf-v6-u-mt-sm report-gap-2">
                  <span class="pf-v6-u-font-size-xl report-font-semibold pf-v6-u-text-color-regular" x-text="item.count"></span>
                  <span class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-text="matchShare(item.count)"></span>
                </span>
              </button>
            </template>
          </div>
          <p x-show="riskCount === 0" class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle report-mt-3">No grounding results to summarise.</p>
        </div>
      </div>
      <div x-show="hasActiveFilters" class="report-mt-3 pf-v6-u-display-flex pf-v6-u-flex-wrap pf-v6-u-align-items-center report-gap-3 pf-v6-u-font-size-sm">
        <span class="pf-v6-u-text-color-subtle" x-text="'Showing ' + visibleRisks.length + ' of ' + riskCount + ' matches in the findings below.'"></span>
        <button type="button" @click="scrollToFindings()" class="asago-link report-font-medium report-hover-underline">Go to filtered findings &darr;</button>
        <button type="button" @click="resetFilters()" class="pf-v6-u-text-color-subtle report-hover-underline">Reset filters</button>
      </div>
    </section>

    <!-- 3. Findings -->
    <section id="findings" class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5" aria-labelledby="findings-heading">
      <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap pf-v6-u-align-items-flex-end pf-v6-u-justify-content-space-between report-gap-3 pf-v6-u-mb-md">
        <div>
          <p class="pf-v6-u-font-size-xs report-font-semibold asago-link report-uppercase report-tracking-wide pf-v6-u-mb-sm">03 / Findings</p>
          <h2 id="findings-heading" tabindex="-1" class="pf-v6-u-font-size-xl report-font-semibold pf-v6-u-text-color-regular">Explore findings</h2>
          <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-mt-xs">Open a risk to read the supporting policy passages and risk context.</p>
        </div>
        <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle" aria-live="polite" x-text="'Showing ' + visibleRisks.length + ' of ' + riskCount + ' matches'"></p>
      </div>
      <!-- Filter bar -->
      <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap pf-v6-u-align-items-center report-gap-3 pf-v6-u-mb-md pf-v6-u-font-size-sm">
        <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1">
          <label class="pf-v6-u-text-color-subtle pf-v6-u-font-size-xs">Theme:</label>
          <div class="report-relative" x-data="{ themesOpen: false }" @keydown.escape.stop.prevent="themesOpen = false; $refs.themesButton.focus()" @click.outside="themesOpen = false">
            <button type="button" x-ref="themesButton" aria-label="Filter by theme" @click="themesOpen = !themesOpen"
                    :aria-expanded="themesOpen"
                    class="pf-v6-c-button pf-m-control pf-v6-u-display-flex report-min-w-28 report-max-w-48 report-gap-2 pf-v6-u-align-items-center pf-v6-u-justify-content-space-between report-border report-border-default report-rounded pf-v6-u-px-sm pf-v6-u-py-xs pf-v6-u-font-size-xs report-bg-primary pf-v6-u-text-align-start">
              <span x-text="themeFilterLabel"></span>
              <span aria-hidden="true" class="pf-v6-u-ml-xs pf-v6-u-text-color-subtle">&#9662;</span>
            </button>
            <div x-show="themesOpen" x-transition
                 class="report-absolute report-left-0 report-top-full report-z-30 pf-v6-u-mt-xs report-w-72 report-max-w-menu report-max-h-80 report-overflow-y-auto report-rounded report-border report-border-default report-bg-primary pf-v6-u-p-xs pf-v6-u-box-shadow-lg"
                 role="group" aria-label="Theme">
