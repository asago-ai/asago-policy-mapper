        </div>
        <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-1">
          <label class="pf-v6-u-text-color-subtle pf-v6-u-font-size-xs">Search:</label>
          <input type="text" x-model="searchQuery" aria-label="Search risks" placeholder="Risk name or ID..."
                 class="report-border report-border-default report-rounded pf-v6-u-px-sm pf-v6-u-py-xs pf-v6-u-font-size-xs report-bg-primary report-w-40" />
        </div>
        <button type="button" @click="resetFilters()" :disabled="!hasActiveFilters"
                class="pf-v6-u-font-size-xs report-font-medium asago-link report-hover-underline report-disabled-opacity-40 report-disabled-cursor-default">
          Reset filters
        </button>
      </div>


      <div class="report-relative report-overflow-x-auto">
        <table class="pf-v6-c-table asago-findings-table report-w-full pf-v6-u-font-size-sm">
          <caption class="pf-v6-screen-reader">Matched risks and their supporting evidence</caption>
          <thead>
            <tr class="risk-table-grid report-px-3 pf-v6-u-text-align-start pf-v6-u-font-size-xs report-border-b report-border-default">
              <template x-for="column in findingColumns" :key="column.key">
                <th scope="col" class="report-font-semibold"
                    :aria-sort="sortBy === column.key ? (sortDesc ? 'descending' : 'ascending') : 'none'"
                    :class="column.key === 'evidence_count' ? 'pf-v6-u-text-align-end' : ''">
                  <button type="button" @click="toggleSort(column.key)">
                    <span x-text="column.label"></span>
                    <span x-show="sortBy === column.key" x-text="sortDesc ? ' ↓' : ' ↑'" class="asago-link"></span>
                  </button>
                </th>
              </template>
              <th scope="col"><span class="pf-v6-screen-reader">Expand finding</span></th>
            </tr>
          </thead>
          <tbody>
            <template x-for="risk in sortedRisks(visibleRisks, sortBy, sortDesc)" :key="risk.risk_id">
              <tr class="report-border-b report-border-default" x-data="{ expanded: false }">
                <td colspan="5" class="pf-v6-u-p-0">
                  <div class="risk-table-grid pf-v6-u-align-items-center report-cursor-pointer report-hover-bg-secondary report-px-3 pf-v6-u-py-md" @click="expanded = !expanded">
                    <div class="report-min-w-0 pf-v6-u-pr-md">
                      <button type="button" class="pf-v6-u-text-align-start report-font-semibold pf-v6-u-text-color-regular"
                              @click.stop="expanded = !expanded" :aria-expanded="expanded"
                              :aria-controls="'finding-' + encodeURIComponent(risk.risk_id)"
                              x-text="risk.risk_name || risk.risk_id"></button>
                      <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-1 pf-v6-u-mt-sm" aria-label="Themes">
                        <template x-for="themeId in riskThemeIds(risk)" :key="themeId">
                          <span class="pf-v6-c-label asago-tag report-rounded pf-v6-u-px-sm report-py-half pf-v6-u-font-size-xs" x-text="themeLabel(themeId)"></span>
                        </template>
                      </div>
                    </div>
                    <div class="report-pr-3 report-min-w-0">
                      <span class="pf-v6-u-display-inline-block report-rounded pf-v6-u-px-sm pf-v6-u-py-xs pf-v6-u-font-size-xs report-break-all"
                            :class="taxonomyColor(risk.taxonomy)"
                            x-text="taxonomyLabel(taxonomyFilterValue(risk.taxonomy))"></span>
                    </div>
                    <div class="report-pr-3">
                      <span class="pf-v6-u-px-sm pf-v6-u-py-xs report-rounded pf-v6-u-font-size-xs report-font-medium"
                            :class="groundingColor(risk.grounding_confidence)"
                            x-text="groundingLabel(groundingValue(risk.grounding_confidence))"></span>
                    </div>
                    <div class="pf-v6-u-text-align-end report-pr-3 pf-v6-u-text-color-subtle report-tabular-nums" x-text="(risk.evidence || []).length"></div>
                    <svg class="report-w-5 report-h-5 pf-v6-u-text-color-subtle chevron" :class="expanded ? 'report-rotate-180' : ''"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </div>
                  <template x-if="expanded">
                    <div :id="'finding-' + encodeURIComponent(risk.risk_id)" class="pf-v6-u-px-md report-py-5 report-space-y-5 report-bg-secondary report-border-t report-border-default">
                      <!-- Evidence spans -->
                      <div x-show="(risk.evidence || []).length > 0">
                        <p class="tip pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-xs" tabindex="0" data-tip="Direct quotes from the document supporting this risk extraction.">Supporting evidence</p>
                        <div class="report-space-y-3">
                          <template x-for="(ev, ei) in risk.evidence || []" :key="ei">
                            <div class="pf-v6-c-card asago-evidence-card asago-evidence report-rounded-lg pf-v6-u-p-md">
                              <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-regular report-dark-text-regular report-italic" x-text="'“' + ev.text + '”'"></p>
                              <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap pf-v6-u-align-items-center report-gap-1 pf-v6-u-mt-xs pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">
                                <span class="report-font-medium" x-text="fileName(ev.document)"></span>
                                <span x-show="ev.page != null">&middot;</span>
                                <span x-show="ev.page != null" x-text="'p.' + ev.page"></span>
                                <span x-show="ev.section">&middot;</span>
                                <span x-show="ev.section" x-text="ev.section"></span>
                              </div>
                            </div>
                          </template>
                        </div>
                      </div>
                      <p x-show="!(risk.evidence || []).length" class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-py-sm">
                        No supporting quotes were saved for this match.
                        <span x-show="risk.grounding_confidence === 'ungrounded'">Grounding was skipped.</span>
                      </p>
                      <!-- Description -->
                      <div>
                        <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-xs">Risk definition</p>
                        <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-regular" x-text="risk.risk_description"></p>
                      </div>
                      <details class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">
                        <summary class="report-cursor-pointer asago-link report-w-fit">How this risk was grouped</summary>
                        <p x-show="!(risk.theme_links || []).length" class="pf-v6-u-mt-sm">No supported category-to-theme link is available for this risk yet. It remains visible in Other / not yet grouped.</p>
                        <ul x-show="(risk.theme_links || []).length" class="pf-v6-u-mt-sm report-space-y-2">
                          <template x-for="link in risk.theme_links || []" :key="link.taxonomy + ':' + link.category_id">
                            <li>
                              <span class="report-font-medium pf-v6-u-text-color-regular" x-text="link.category_label"></span>
                              <span x-text="' (' + link.taxonomy_label + ') → '"></span>
                              <span x-text="link.theme_ids.map(id => themeLabel(id)).join(', ')"></span>
                            </li>
                          </template>
                        </ul>
                      </details>
                      <!-- Causal chain (DPV) -->
                      <div x-show="risk.threat || risk.consequence">
                        <p class="tip pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-xs" tabindex="0"
                           data-tip="DPV causal chain: what event causes this risk (Threat), what system weakness is exploited (Vulnerability), what happens if materialized (Consequence), and who is harmed (Impact).">Causal explanation</p>
                        <div class="pf-v6-u-display-grid report-grid-cols-2 report-gap-2 pf-v6-u-font-size-xs">
                          <div x-show="risk.threat" class="report-rounded pf-v6-u-p-sm report-bg-danger report-border report-border-danger">
                            <span class="report-font-semibold pf-v6-u-text-color-status-danger">Threat</span>
                            <p class="pf-v6-u-text-color-status-danger report-mt-half" x-text="risk.threat"></p>
                            <p x-show="risk.threat_source" class="pf-v6-u-text-color-status-danger pf-v6-u-mt-xs report-opacity-75">
                              <span class="report-font-medium">Source:</span> <span x-text="risk.threat_source"></span>
                            </p>
                          </div>
                          <div x-show="risk.vulnerability" class="report-rounded pf-v6-u-p-sm report-bg-warning report-border report-border-warning">
                            <span class="report-font-semibold pf-v6-u-text-color-status-warning">Vulnerability</span>
                            <p class="pf-v6-u-text-color-status-warning report-mt-half" x-text="risk.vulnerability"></p>
                          </div>
                          <div x-show="risk.consequence" class="report-rounded pf-v6-u-p-sm report-bg-warning report-border report-border-warning">
                            <span class="report-font-semibold pf-v6-u-text-color-status-warning">Consequence</span>
                            <p class="pf-v6-u-text-color-status-warning report-mt-half" x-text="risk.consequence"></p>
                          </div>
                          <div x-show="risk.impact" class="report-rounded pf-v6-u-p-sm report-bg-danger report-border report-border-danger">
                            <span class="report-font-semibold pf-v6-u-text-color-status-danger">Impact</span>
                            <p class="pf-v6-u-text-color-status-danger report-mt-half" x-text="risk.impact"></p>
                          </div>
                        </div>
                      </div>
                      <!-- Mitigations -->
                      <div x-show="(risk.mitigations || []).length > 0" x-data="{ mitOpen: false }">
                        <p class="tip pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-xs report-cursor-pointer report-select-none" tabindex="0" @click="mitOpen = !mitOpen"
                           @keydown.enter.prevent="mitOpen = !mitOpen" @keydown.space.prevent="mitOpen = !mitOpen"
                           data-tip="Recommended mitigation actions from NIST, OWASP, and AIUC-1 frameworks, categorized as technical (engineering deploys), operational (ops/QA executes), or governance (leadership/compliance owns).">
                          Related mitigation guidance
                          <span class="pf-v6-u-text-color-subtle pf-v6-u-font-family-monospace" x-text="'(' + (risk.mitigations || []).length + ')'"></span>
                          <template x-for="cat in ['technical','operational','governance']" :key="cat">
                            <span class="pf-v6-u-ml-xs pf-v6-u-px-xs report-py-half report-rounded pf-v6-u-font-size-xs"
                                  :class="cat === 'technical' ? 'report-bg-brand pf-v6-u-text-color-link' : cat === 'operational' ? 'report-bg-warning pf-v6-u-text-color-status-warning' : 'report-bg-custom pf-v6-u-text-color-status-custom'"
                                  x-text="cat[0].toUpperCase() + ':' + (risk.mitigations || []).filter(m => m.category === cat).length"
                                  x-show="(risk.mitigations || []).filter(m => m.category === cat).length > 0"></span>
                          </template>
                          <svg class="report-w-3 report-h-3 pf-v6-u-display-inline pf-v6-u-ml-xs pf-v6-u-text-color-subtle chevron"
                               :class="mitOpen ? 'report-rotate-180' : ''"
                               fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                          </svg>
                        </p>
                        <div x-show="mitOpen" class="report-space-y-2">
                          <template x-for="cat in ['technical','operational','governance']" :key="cat">
                            <div x-show="(risk.mitigations || []).filter(m => m.category === cat).length > 0">
                              <p class="pf-v6-u-font-size-xs report-font-semibold pf-v6-u-mt-xs report-mb-half"
                                 :class="cat === 'technical' ? 'pf-v6-u-text-color-link' : cat === 'operational' ? 'pf-v6-u-text-color-status-warning' : 'pf-v6-u-text-color-status-custom'"
                                 x-text="cat.charAt(0).toUpperCase() + cat.slice(1)"></p>
                              <template x-for="src in [...new Set((risk.mitigations || []).filter(m => m.category === cat).map(m => m.source))].sort()" :key="src">
                                <div class="pf-v6-u-ml-sm pf-v6-u-mb-xs">
                                  <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-text="src"></p>
                                  <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-1">
                                    <template x-for="m in (risk.mitigations || []).filter(m => m.category === cat && m.source === src)" :key="m.action_id">
                                      <div class="tip report-rounded pf-v6-u-font-size-xs report-p-one-half pf-v6-u-mb-xs" tabindex="0"
                                           :class="cat === 'technical' ? 'report-bg-brand pf-v6-u-text-color-link' : cat === 'operational' ? 'report-bg-warning pf-v6-u-text-color-status-warning' : 'report-bg-custom pf-v6-u-text-color-status-custom'"
                                           :data-tip="m.action_id">
                                        <span class="report-font-semibold" x-text="m.action_name || m.action_id"></span>
                                        <span x-show="m.risk_control" class="pf-v6-u-ml-xs pf-v6-u-px-xs report-py-half report-rounded pf-v6-u-font-size-xs report-opacity-60 pf-v6-u-font-weight-normal report-bg-tertiary pf-v6-u-text-color-regular"
                                              x-text="m.risk_control?.replace('Control','')"></span>
                                        <p x-show="m.description" class="report-mt-half pf-v6-u-font-size-xs report-opacity-80 pf-v6-u-font-weight-normal" x-text="m.description"></p>
                                      </div>
                                    </template>
                                  </div>
                                </div>
                              </template>
                            </div>
                          </template>
                        </div>
                      </div>

                      <div x-data="{ riskTechnicalOpen: false }">
                        <button type="button" @click="riskTechnicalOpen = !riskTechnicalOpen" :aria-expanded="riskTechnicalOpen"
                                class="pf-v6-u-font-size-xs report-font-semibold pf-v6-u-text-color-subtle pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2">
                          <span aria-hidden="true" x-text="riskTechnicalOpen ? '−' : '+'"></span> Technical details for this match
                        </button>
                        <template x-if="riskTechnicalOpen">
                          <div class="report-space-y-4 report-mt-3">
                            <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-break-all">Risk ID: <span x-text="risk.risk_id"></span></p>
                            <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-4 pf-v6-u-align-items-center pf-v6-u-font-size-xs">
                              <span>Accepted by:
                                <span class="pf-v6-u-px-sm pf-v6-u-py-xs report-rounded" :class="acceptedByColor(risk.accepted_by)" x-text="acceptedByLabel(risk.accepted_by)"></span>
                              </span>
                            </div>
                            <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-show="(risk.evidence || []).length">
                              Evidence chunks: <span x-text="(risk.evidence || []).map(ev => fileName(ev.document) + ' #' + ev.chunk_index).join(', ')"></span>
                            </p>
                            <!-- Score breakdown -->
                            <div class="score-breakdown">
                              <h3 class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-regular pf-v6-u-mb-xs">Score breakdown</h3>
                              <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-mb-3">These scores help shortlist risks using document passages or generated search queries. Their meaning depends on the search method and model. Use the supporting quotes and grounding confidence to assess how well the document supports this match.</p>
                              <div class="pf-v6-u-display-grid report-grid-cols-1 report-grid-cols-2-lg report-gap-3">
                                <template x-for="score in scoreBreakdown(risk)" :key="score.key">
                                  <div class="pf-v6-c-card asago-score-card report-rounded-lg pf-v6-u-p-md" :data-score="score.key">
                                    <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap pf-v6-u-align-items-baseline pf-v6-u-justify-content-space-between report-gap-2">
                                      <h4 class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-regular" x-text="score.label"></h4>
                                      <span class="pf-v6-u-font-size-lg report-font-semibold pf-v6-u-text-color-regular report-tabular-nums" x-text="score.value"></span>
                                    </div>
                                    <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-sm" x-text="score.description"></p>
                                    <p class="pf-v6-u-font-size-xs report-font-semibold asago-link report-mt-3">
                                      <span x-text="score.direction"></span> &middot; Range: <span x-text="score.range"></span>
                                    </p>
                                    <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-sm" x-text="score.interpretation"></p>
                                  </div>
                                </template>
                              </div>
                              <details class="report-mt-3 pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">
                                <summary class="report-cursor-pointer report-w-fit">Raw stored values</summary>
                                <p class="pf-v6-u-mt-sm">The confidence field stores the retrieval score selected by the extraction mode. Grounding confidence is recorded separately.</p>
                                <pre class="report-whitespace-pre-wrap report-overflow-x-auto pf-v6-u-mt-sm report-p-3 report-rounded report-bg-primary" x-text="formatJSON({ confidence: risk.confidence, ...risk.scores })"></pre>
                              </details>
                            </div>
                            <!-- Inline LLM calls for this risk -->
                            <div x-show="riskCalls(risk.risk_id).length > 0">
                              <p class="tip pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-xs" tabindex="0" data-tip="LLM calls that involved this risk (grounding verification, borderline judging).">LLM Calls</p>
                              <div class="report-space-y-2">
                                <template x-for="call in riskCalls(risk.risk_id)" :key="call.call_id">
                                  <div class="report-border report-border-default report-rounded report-bg-primary" x-data="{ callOpen: false }">
                                    <div class="pf-v6-u-display-flex pf-v6-u-align-items-center pf-v6-u-justify-content-space-between pf-v6-u-px-sm report-py-one-half report-cursor-pointer report-hover-bg-secondary pf-v6-u-font-size-xs"
                                         @click="callOpen = !callOpen">
                                      <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2">
                                        <span class="stage-badge"
                                              :class="call.stage === 'grounding' ? 'report-bg-success pf-v6-u-text-color-status-success' : 'report-bg-warning pf-v6-u-text-color-status-warning'"
                                              x-text="call.stage"></span>
                                        <span class="pf-v6-u-font-family-monospace pf-v6-u-text-color-subtle" x-text="call.call_id"></span>
                                        <span class="pf-v6-u-text-color-subtle" x-text="call.duration_ms?.toFixed(0) + 'ms'"></span>
                                      </div>
                                      <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2">
                                        <span class="pf-v6-u-text-color-subtle" x-text="call.result_summary"></span>
                                        <svg class="report-w-4 report-h-4 pf-v6-u-text-color-subtle chevron"
                                             :class="callOpen ? 'report-rotate-180' : ''"
                                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                        </svg>
                                      </div>
                                    </div>
                                    <div x-show="callOpen" class="pf-v6-u-px-sm pf-v6-u-pb-sm report-border-t report-border-default report-space-y-2">
                                      <template x-for="(msg, mi) in call.messages || []" :key="mi">
                                        <div class="pf-v6-u-mt-xs">
                                          <span class="pf-v6-u-font-size-xs report-font-semibold report-uppercase"
                                                :class="msg.role === 'system' ? 'pf-v6-u-text-color-status-custom' : msg.role === 'user' ? 'pf-v6-u-text-color-link' : 'pf-v6-u-text-color-status-success'"
                                                x-text="msg.role"></span>
                                          <pre class="pf-v6-u-font-size-xs pf-v6-u-text-color-regular report-whitespace-pre-wrap report-mt-half report-max-h-40 report-overflow-y-auto report-bg-secondary report-rounded pf-v6-u-p-xs" x-text="msg.content"></pre>
                                        </div>
                                      </template>
                                      <div>
                                        <span class="pf-v6-u-font-size-xs report-font-semibold report-uppercase pf-v6-u-text-color-status-success">Response</span>
                                        <pre class="pf-v6-u-font-size-xs pf-v6-u-text-color-regular report-whitespace-pre-wrap report-mt-half report-max-h-40 report-overflow-y-auto report-bg-secondary report-rounded pf-v6-u-p-xs" x-text="formatJSON(call.response)"></pre>
                                      </div>
                                    </div>
                                  </div>
                                </template>
                              </div>
                            </div>

                          </div>
                        </template>
                      </div>
                    </div>
                  </template>
                </td>
              </tr>
            </template>
          </tbody>
        </table>
      </div>
      <div x-show="visibleRisks.length === 0" class="pf-v6-u-text-align-center pf-v6-u-text-color-subtle pf-v6-u-py-xl">
        <p x-text="riskCount ? 'No risks match the current filters.' : 'No risk matches were recorded in this analysis.'"></p>
        <button type="button" x-show="hasActiveFilters" @click="resetFilters()" class="pf-v6-u-mt-sm pf-v6-u-font-size-sm asago-link report-hover-underline">Reset filters</button>
      </div>
    </section>

    <!-- 4. Technical appendix -->
    <section id="technical-details" class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5" x-data="{ technicalOpen: false }">
      <h2>
        <button type="button" @click="technicalOpen = !technicalOpen" :aria-expanded="technicalOpen"
                class="pf-v6-u-display-flex report-w-full pf-v6-u-align-items-center pf-v6-u-justify-content-space-between report-gap-4 pf-v6-u-text-align-start">
          <span>
            <span class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-regular">Technical details</span>
            <span class="pf-v6-u-display-block pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-xs">Grouping methodology, processing statistics, configuration, document chunks and model call logs</span>
          </span>
          <span class="pf-v6-u-text-color-subtle" aria-hidden="true" x-text="technicalOpen ? '−' : '+'"></span>
        </button>
      </h2>
      <template x-if="technicalOpen">
        <div class="report-space-y-4 pf-v6-u-mt-md">
          <details class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5 pf-v6-u-font-size-sm pf-v6-u-text-color-subtle">
            <summary class="report-cursor-pointer report-font-semibold">Theme grouping</summary>
            <p class="report-mt-3 report-font-medium pf-v6-u-text-color-regular" x-text="themeCoverageText"></p>
            <p class="pf-v6-u-mt-sm">Themes use curated links from risks to NIST, OWASP and AILuminate categories. Only exact, close or broader-category links are used. Source categories are shown inside each finding. Matches without a supported link remain in Other / not yet grouped.</p>
            <p class="pf-v6-u-mt-sm">A risk can belong to several themes, so theme counts may add up to more than the total. Selecting several themes shows each matching risk once. Mapping coverage is partial and varies by taxonomy; it does not measure extraction accuracy or policy completeness.</p>
            <p class="pf-v6-u-mt-sm">Themes with no matches are omitted. Their absence does not establish that a topic is absent from your policy.</p>
          </details>
          <section class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5" x-data="{ statsOpen: false }">
            <h3>
              <button type="button" class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-subtle report-uppercase report-tracking-wide pf-v6-u-mb-xs report-w-full pf-v6-u-text-align-start pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2"
                      @click="statsOpen = !statsOpen" :aria-expanded="statsOpen">
                <span class="tip" data-tip="Detailed pipeline performance metrics: timing breakdown, token usage, and configuration parameters.">Processing statistics</span>
                <span class="tip-icon tip" data-tip="Timing, tokens, and configuration.">i</span>
                <svg class="report-w-5 report-h-5 pf-v6-u-text-color-subtle chevron pf-v6-u-ml-auto"
                     :class="statsOpen ? 'report-rotate-180' : ''"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
            </h3>
            <div x-show="statsOpen" class="report-mt-3 report-space-y-4">
              <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">These counts describe candidate processing across document chunks.</p>
              <div class="pf-v6-u-display-grid report-grid-cols-2 report-grid-cols-5-md report-gap-3">
                <template x-for="stat in processingStats" :key="stat.key">
                  <div class="report-p-3 report-rounded-lg report-bg-secondary">
                    <p class="pf-v6-u-font-size-xl report-font-semibold pf-v6-u-text-color-regular" x-text="formatNumber(data.retrieval_stats?.[stat.key] || 0)"></p>
                    <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-xs" x-text="stat.label"></p>
                  </div>
                </template>
              </div>
              <!-- Timing -->
              <div x-show="Object.keys(data.retrieval_stats?.timing_ms || {}).length > 0">
                <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-sm report-font-semibold">Timing Breakdown</p>
                <div class="report-space-y-1">
                  <template x-for="[stage, ms] in sortedTimings()" :key="stage">
                    <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-3 pf-v6-u-font-size-sm">
                      <span class="report-w-28 pf-v6-u-text-align-end pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-font-family-monospace" x-text="stage"></span>
                      <div class="pf-v6-u-flex-1 report-bg-tertiary report-rounded report-overflow-hidden report-h-5">
                        <div class="timing-bar asago-chart-bar pf-v6-u-display-flex pf-v6-u-align-items-center pf-v6-u-justify-content-flex-end pf-v6-u-px-xs"
                             :style="`width: ${Math.max((ms / maxTiming) * 100, 2)}%`">
                          <span class="report-text-xxs report-text-white pf-v6-u-font-family-monospace" x-text="ms >= 1000 ? (ms / 1000).toFixed(1) + 's' : ms.toFixed(0) + 'ms'"></span>
                        </div>
                      </div>
                    </div>
                  </template>
                </div>
              </div>

              <!-- Token usage -->
              <div x-show="Object.keys(data.token_usage || {}).length > 0">
                <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-sm report-font-semibold">Token Usage</p>
                <div class="pf-v6-u-display-grid report-grid-cols-2 report-grid-cols-4-md report-gap-3">
                  <template x-if="data.token_usage?.prompt_tokens != null">
                    <div class="pf-v6-u-text-align-center report-p-3 report-bg-secondary report-rounded-lg">
                      <p class="pf-v6-u-font-size-xl pf-v6-u-font-weight-bold pf-v6-u-text-color-link" x-text="formatNumber(data.token_usage.prompt_tokens)"></p>
                      <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-xs">Prompt Tokens</p>
                    </div>
                  </template>
                  <template x-if="data.token_usage?.completion_tokens != null">
                    <div class="pf-v6-u-text-align-center report-p-3 report-bg-secondary report-rounded-lg">
                      <p class="pf-v6-u-font-size-xl pf-v6-u-font-weight-bold pf-v6-u-text-color-status-success" x-text="formatNumber(data.token_usage.completion_tokens)"></p>
                      <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-xs">Completion Tokens</p>
                    </div>
                  </template>
                  <template x-if="data.token_usage?.total_tokens != null">
                    <div class="pf-v6-u-text-align-center report-p-3 report-bg-secondary report-rounded-lg">
                      <p class="pf-v6-u-font-size-xl pf-v6-u-font-weight-bold pf-v6-u-text-color-status-custom" x-text="formatNumber(data.token_usage.total_tokens)"></p>
                      <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-xs">Total Tokens</p>
                    </div>
                  </template>
                  <template x-if="data.token_usage?.calls != null">
                    <div class="pf-v6-u-text-align-center report-p-3 report-bg-secondary report-rounded-lg">
                      <p class="pf-v6-u-font-size-xl pf-v6-u-font-weight-bold pf-v6-u-text-color-status-warning" x-text="data.token_usage.calls"></p>
                      <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mt-xs">LLM Calls</p>
                    </div>
                  </template>
                </div>
              </div>

              <!-- Configuration echo -->
              <div id="report-configuration" x-show="Object.keys(data.metadata || {}).length > 0">
                <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-sm report-font-semibold">Configuration</p>
                <div class="report-relative report-overflow-x-auto">
                  <table class="pf-v6-c-table report-w-full report-table-fixed pf-v6-u-font-size-sm">
                    <caption class="pf-v6-screen-reader">Extraction settings</caption>
                    <tbody>
                      <template x-for="[key, val] in Object.entries(data.metadata || {})" :key="key">
                        <tr class="report-border-b report-border-default" :data-setting="key">
                          <th scope="row" class="report-w-third report-w-quarter-sm pf-v6-u-py-sm pf-v6-u-pr-md report-align-top pf-v6-u-text-align-start pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-font-family-monospace pf-v6-u-font-weight-normal report-break-all" x-text="key"></th>
                          <td class="pf-v6-u-py-sm report-align-top pf-v6-u-font-size-xs pf-v6-u-text-color-regular pf-v6-u-font-family-monospace">
                            <template x-if="isExpandableMetadata(val)">
                              <details>
                                <summary class="report-cursor-pointer asago-link report-w-fit" x-text="metadataValueLabel(val)"></summary>
                                <pre class="pf-v6-u-mt-sm report-p-3 report-rounded report-border report-border-brand report-bg-secondary pf-v6-u-text-color-regular report-whitespace-pre-wrap report-break-words report-max-h-80 report-overflow-auto" x-text="formatJSON(val)"></pre>
                              </details>
                            </template>
                            <template x-if="!isExpandableMetadata(val)">
                              <span class="report-whitespace-pre-wrap report-break-all" x-text="metadataValueLabel(val)"></span>
                            </template>
                          </td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </section>
          <section class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5" x-data="{ chunksOpen: false }">
            <h3>
              <button type="button" class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-subtle report-uppercase report-tracking-wide pf-v6-u-mb-xs report-w-full pf-v6-u-text-align-start pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2"
                      @click="chunksOpen = !chunksOpen" :aria-expanded="chunksOpen">
                <span class="tip" data-tip="Chronological view of all document chunks processed by the retrieval pipeline, with per-chunk retrieval statistics.">Chunks Timeline</span>
                <span class="tip-icon tip" data-tip="Click to expand the chunk-by-chunk processing timeline.">i</span>
                <span class="pf-v6-u-font-size-xs pf-v6-u-font-weight-normal pf-v6-u-text-color-subtle" x-text="`(${(data.chunks || []).length} chunks)`"></span>
                <svg class="report-w-5 report-h-5 pf-v6-u-text-color-subtle chevron pf-v6-u-ml-auto"
                     :class="chunksOpen ? 'report-rotate-180' : ''"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
            </h3>
            <div x-show="chunksOpen" class="report-mt-3 report-space-y-2">
              <template x-for="chunk in data.chunks || []" :key="chunk.index">
                <div class="report-border report-border-default report-rounded-lg report-p-3"
                     :class="(chunk.accepted_risk_ids || []).length > 0 ? 'report-border-l-4 asago-evidence' : ''">
                  <div class="pf-v6-u-display-flex pf-v6-u-align-items-flex-start pf-v6-u-justify-content-space-between report-gap-3">
                    <div class="pf-v6-u-flex-1 report-min-w-0">
                      <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2 pf-v6-u-mb-xs">
                        <span class="pf-v6-u-px-sm report-py-half report-rounded pf-v6-u-font-size-xs report-bg-tertiary pf-v6-u-text-color-regular pf-v6-u-font-family-monospace report-font-semibold"
                              x-text="'#' + chunk.index"></span>
                        <span class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-text="fileName(chunk.source)"></span>
                        <span x-show="chunk.page != null" class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-text="'p.' + chunk.page"></span>
                        <span x-show="chunk.section" class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-text="chunk.section"></span>
                      </div>
                      <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-line-clamp-2" x-text="chunk.text_preview"></p>
                    </div>
                    <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2 pf-v6-u-font-size-xs pf-v6-u-flex-shrink-0">
                      <span class="tip report-px-one-half report-py-half report-rounded report-bg-brand pf-v6-u-text-color-link pf-v6-u-font-family-monospace" tabindex="0"
                            data-tip="Total candidates retrieved for this chunk" x-text="chunk.candidates_retrieved"></span>
                      <span class="tip report-px-one-half report-py-half report-rounded report-bg-success pf-v6-u-text-color-status-success pf-v6-u-font-family-monospace" tabindex="0"
                            data-tip="Auto-accepted (above high threshold)" x-text="chunk.auto_accepted"></span>
                      <span class="tip report-px-one-half report-py-half report-rounded report-bg-warning pf-v6-u-text-color-status-warning pf-v6-u-font-family-monospace" tabindex="0"
                            data-tip="Borderline candidates sent to LLM judge" x-text="chunk.borderline"></span>
                      <span class="tip report-px-one-half report-py-half report-rounded report-bg-danger pf-v6-u-text-color-status-danger pf-v6-u-font-family-monospace" tabindex="0"
                            data-tip="Discarded (below low threshold)" x-text="chunk.discarded"></span>
                    </div>
                  </div>
                  <div x-show="(chunk.accepted_risk_ids || []).length > 0" class="pf-v6-u-mt-sm pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-1">
                    <template x-for="rid in chunk.accepted_risk_ids || []" :key="rid">
                      <span class="report-px-one-half report-py-half report-rounded report-text-xxs asago-tag pf-v6-u-font-family-monospace" x-text="rid"></span>
                    </template>
                  </div>
                </div>
              </template>
              <p x-show="(data.chunks || []).length === 0" class="pf-v6-u-text-align-center pf-v6-u-text-color-subtle pf-v6-u-py-md">No chunk data available.</p>
            </div>
          </section>
          <section class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5" x-data="{ callsOpen: false }">
            <h3>
              <button type="button" class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-subtle report-uppercase report-tracking-wide pf-v6-u-mb-xs report-w-full pf-v6-u-text-align-start pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2"
                      @click="callsOpen = !callsOpen" :aria-expanded="callsOpen">
                <span class="tip" data-tip="Chronological log of all LLM calls made during the extraction pipeline (borderline judging, grounding verification).">LLM Call Log</span>
                <span class="tip-icon tip" data-tip="Full request/response log for every LLM call.">i</span>
                <span class="pf-v6-u-font-size-xs pf-v6-u-font-weight-normal pf-v6-u-text-color-subtle" x-text="`(${(data.llm_calls || []).length} calls)`"></span>
                <svg class="report-w-5 report-h-5 pf-v6-u-text-color-subtle chevron pf-v6-u-ml-auto"
                     :class="callsOpen ? 'report-rotate-180' : ''"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
            </h3>
            <div x-show="callsOpen" class="report-mt-3 report-space-y-2">
              <template x-for="call in data.llm_calls || []" :key="call.call_id">
                <div class="report-border report-border-default report-rounded-lg" x-data="{ logOpen: false }">
                  <div class="pf-v6-u-display-flex pf-v6-u-align-items-center pf-v6-u-justify-content-space-between report-px-3 pf-v6-u-py-sm report-cursor-pointer report-hover-bg-secondary"
                       @click="logOpen = !logOpen">
                    <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2 pf-v6-u-font-size-sm">
                      <span class="stage-badge"
                            :class="call.stage === 'grounding' ? 'report-bg-success pf-v6-u-text-color-status-success' : 'report-bg-warning pf-v6-u-text-color-status-warning'"
                            x-text="call.stage"></span>
                      <span class="pf-v6-u-font-family-monospace pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-text="call.call_id"></span>
                      <span class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle" x-text="'chunk ' + call.chunk_index"></span>
                      <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-1">
                        <template x-for="rid in call.risk_ids || []" :key="rid">
                          <span class="pf-v6-u-px-xs report-py-half report-rounded report-text-xxs report-bg-secondary pf-v6-u-text-color-subtle pf-v6-u-font-family-monospace" x-text="rid"></span>
                        </template>
                      </div>
                    </div>
                    <div class="pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2 pf-v6-u-font-size-xs">
                      <span class="pf-v6-u-text-color-subtle pf-v6-u-font-family-monospace" x-text="(call.duration_ms?.toFixed(0) || '?') + 'ms'"></span>
                      <span class="pf-v6-u-px-sm report-py-half report-rounded report-bg-secondary pf-v6-u-text-color-regular" x-text="call.result_summary"></span>
                      <svg class="report-w-4 report-h-4 pf-v6-u-text-color-subtle chevron"
                           :class="logOpen ? 'report-rotate-180' : ''"
                           fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </div>
                  </div>
                  <div x-show="logOpen" class="report-px-3 report-pb-3 report-border-t report-border-default report-space-y-2">
                    <template x-for="(msg, mi) in call.messages || []" :key="mi">
                      <div class="pf-v6-u-mt-sm">
                        <span class="pf-v6-u-font-size-xs report-font-semibold report-uppercase"
                              :class="msg.role === 'system' ? 'pf-v6-u-text-color-status-custom' : msg.role === 'user' ? 'pf-v6-u-text-color-link' : 'pf-v6-u-text-color-status-success'"
                              x-text="msg.role"></span>
                        <pre class="pf-v6-u-font-size-xs pf-v6-u-text-color-regular report-whitespace-pre-wrap report-mt-half report-max-h-60 report-overflow-y-auto report-bg-secondary report-rounded pf-v6-u-p-sm report-border report-border-default" x-text="msg.content"></pre>
                      </div>
                    </template>
                    <div class="pf-v6-u-mt-sm">
                      <span class="pf-v6-u-font-size-xs report-font-semibold report-uppercase pf-v6-u-text-color-status-success">Response</span>
                      <pre class="pf-v6-u-font-size-xs pf-v6-u-text-color-regular report-whitespace-pre-wrap report-mt-half report-max-h-60 report-overflow-y-auto report-bg-secondary report-rounded pf-v6-u-p-sm report-border report-border-default" x-text="formatJSON(call.response)"></pre>
                    </div>
                  </div>
                </div>
              </template>
              <p x-show="(data.llm_calls || []).length === 0" class="pf-v6-u-text-align-center pf-v6-u-text-color-subtle pf-v6-u-py-md">No LLM calls recorded.</p>
            </div>
          </section>

        </div>
      </template>
    </section>

    <!-- 5. Evaluation appendix, only when labelled reference results exist -->
    <template x-if="data.eval">
      <section id="evaluation" class="pf-v6-c-card report-bg-primary report-rounded-xl pf-v6-u-box-shadow-sm report-border report-border-default report-p-5" x-data="{ evalOpen: false }">
        <h2>
          <button type="button" class="pf-v6-u-font-size-sm report-font-semibold pf-v6-u-text-color-subtle report-uppercase report-tracking-wide pf-v6-u-mb-xs report-w-full pf-v6-u-text-align-start pf-v6-u-display-flex pf-v6-u-align-items-center report-gap-2"
                  @click="evalOpen = !evalOpen" :aria-expanded="evalOpen">
            <span class="tip" data-tip="Detailed evaluation results comparing extracted risk IDs against ground truth.">Evaluation</span>
            <span class="tip-icon tip" data-tip="Matched, missing, and spurious risk IDs.">i</span>
            <span class="pf-v6-u-font-size-xs pf-v6-u-font-weight-normal pf-v6-u-text-color-subtle"
                  x-text="`${data.eval.matched || 0}/${data.eval.total_expected || 0} matched, ${(data.eval.missing || []).length} missing, ${(data.eval.spurious || []).length} spurious`"></span>
            <svg class="report-w-5 report-h-5 pf-v6-u-text-color-subtle chevron pf-v6-u-ml-auto"
                 :class="evalOpen ? 'report-rotate-180' : ''"
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </h2>
        <div x-show="evalOpen" class="report-mt-3">
          <p class="pf-v6-u-font-size-sm pf-v6-u-text-color-subtle pf-v6-u-mb-md">Comparison with labelled reference data for this document.</p>
          <div class="pf-v6-u-display-grid report-grid-cols-2 report-grid-cols-4-md report-gap-3 report-mb-5">
            <div class="report-rounded-lg report-bg-secondary report-p-3">
              <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle pf-v6-u-mb-xs">Evaluation result</p>
              <span class="pf-v6-u-px-sm pf-v6-u-py-xs report-rounded pf-v6-u-font-size-xs pf-v6-u-font-weight-bold report-text-white" :class="evalBadgeClass" x-text="evalBadgeText"></span>
            </div>
            <template x-for="metric in ['precision', 'recall', 'f1']" :key="metric">
              <div class="report-rounded-lg report-bg-secondary report-p-3">
                <p class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle report-capitalize" x-text="metric === 'f1' ? 'F1' : metric"></p>
                <p class="pf-v6-u-font-size-xl report-font-semibold pf-v6-u-text-color-regular pf-v6-u-mt-xs" x-text="formatPercent(data.eval[metric])"></p>
              </div>
            </template>
          </div>
          <div class="pf-v6-u-display-grid report-grid-cols-1 report-grid-cols-3-md report-gap-4">
            <!-- Matched -->
            <div class="report-border report-border-success report-rounded-lg report-p-3">
              <p class="pf-v6-u-font-size-xs report-font-semibold pf-v6-u-text-color-status-success report-uppercase pf-v6-u-mb-sm">Matched
                <span class="pf-v6-u-font-family-monospace pf-v6-u-text-color-status-success" x-text="'(' + (data.eval.matched_ids || []).length + ')'"></span>
              </p>
              <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-1">
                <template x-for="rid in data.eval.matched_ids || []" :key="rid">
                  <span class="pf-v6-u-px-sm report-py-half report-rounded pf-v6-u-font-size-xs report-bg-success pf-v6-u-text-color-status-success pf-v6-u-font-family-monospace" x-text="rid"></span>
                </template>
                <span x-show="!(data.eval.matched_ids || []).length" class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">None</span>
              </div>
            </div>
            <!-- Missing -->
            <div class="report-border report-border-danger report-rounded-lg report-p-3">
              <p class="pf-v6-u-font-size-xs report-font-semibold pf-v6-u-text-color-status-danger report-uppercase pf-v6-u-mb-sm">Missing
                <span class="pf-v6-u-font-family-monospace pf-v6-u-text-color-status-danger" x-text="'(' + (data.eval.missing || []).length + ')'"></span>
              </p>
              <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-1">
                <template x-for="rid in data.eval.missing || []" :key="rid">
                  <span class="pf-v6-u-px-sm report-py-half report-rounded pf-v6-u-font-size-xs report-bg-danger pf-v6-u-text-color-status-danger pf-v6-u-font-family-monospace" x-text="rid"></span>
                </template>
                <span x-show="!(data.eval.missing || []).length" class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">None</span>
              </div>
            </div>
            <!-- Spurious -->
            <div class="report-border report-border-warning report-rounded-lg report-p-3">
              <p class="pf-v6-u-font-size-xs report-font-semibold pf-v6-u-text-color-status-warning report-uppercase pf-v6-u-mb-sm">Spurious
                <span class="pf-v6-u-font-family-monospace pf-v6-u-text-color-status-warning" x-text="'(' + (data.eval.spurious || []).length + ')'"></span>
              </p>
              <div class="pf-v6-u-display-flex pf-v6-u-flex-wrap report-gap-1">
                <template x-for="rid in data.eval.spurious || []" :key="rid">
                  <span class="pf-v6-u-px-sm report-py-half report-rounded pf-v6-u-font-size-xs report-bg-warning pf-v6-u-text-color-status-warning pf-v6-u-font-family-monospace" x-text="rid"></span>
                </template>
                <span x-show="!(data.eval.spurious || []).length" class="pf-v6-u-font-size-xs pf-v6-u-text-color-subtle">None</span>
              </div>
            </div>
          </div>

          <!-- Per-Taxonomy Breakdown -->
          <template x-if="data.eval.per_taxonomy && Object.keys(data.eval.per_taxonomy).length">
            <div class="pf-v6-u-mt-md">
              <p class="pf-v6-u-font-size-xs report-font-semibold pf-v6-u-text-color-subtle report-uppercase pf-v6-u-mb-sm">Per-Taxonomy Breakdown</p>
              <table class="pf-v6-c-table report-w-full pf-v6-u-font-size-xs">
                <thead>
                  <tr class="report-border-b report-border-default">
                    <th class="pf-v6-u-text-align-start pf-v6-u-py-xs pf-v6-u-px-sm pf-v6-u-text-color-subtle">Taxonomy</th>
                    <th class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm pf-v6-u-text-color-subtle">Expected</th>
                    <th class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm pf-v6-u-text-color-subtle">Matched</th>
                    <th class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm pf-v6-u-text-color-subtle">Precision</th>
                    <th class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm pf-v6-u-text-color-subtle">Recall</th>
                    <th class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm pf-v6-u-text-color-subtle">F1</th>
                  </tr>
                </thead>
                <tbody>
                  <template x-for="[tax, td] in Object.entries(data.eval.per_taxonomy).sort()" :key="tax">
                    <tr class="report-border-b report-border-default">
                      <td class="pf-v6-u-py-xs pf-v6-u-px-sm pf-v6-u-font-family-monospace" x-text="tax"></td>
                      <td class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm" x-text="td.expected"></td>
                      <td class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm" x-text="td.matched"></td>
                      <td class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm" x-text="td.precision.toFixed(3)"></td>
                      <td class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm" x-text="td.recall.toFixed(3)"></td>
                      <td class="pf-v6-u-text-align-end pf-v6-u-py-xs pf-v6-u-px-sm report-font-semibold" x-text="td.f1.toFixed(3)"></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
          </template>
        </div>
      </section>
    </template>

  </main>
</div>

<script>
function reportApp() {
  const data = { ...DATA, risks: DATA.risks || [] };
  const otherTheme = { id: 'other', label: 'Other / not yet grouped', description: 'Matches without a supported theme mapping, including custom risks.' };
  const themeCatalog = [...(data.theme_catalog || []).filter(theme => theme.id !== 'other'), otherTheme];
  const themeById = new Map(themeCatalog.map(theme => [theme.id, theme]));
  const riskThemeIds = risk => {
    const ids = [...new Set((risk.theme_ids || []).filter(id => id !== 'other' && themeById.has(id)))];
    return ids.length ? ids : ['other'];
  };
  const themeDistribution = themeCatalog.map(theme => {
    const matches = data.risks.filter(risk => riskThemeIds(risk).includes(theme.id));
    const taxonomies = new Set(matches.map(risk => risk.taxonomy).filter(Boolean));
    return { ...theme, count: matches.length, taxonomyCount: taxonomies.size };
  }).filter(theme => theme.count > 0)
    .sort((a, b) => Number(a.id === 'other') - Number(b.id === 'other')
      || b.count - a.count || a.label.localeCompare(b.label));
  const groupedCount = data.risks.filter(risk => !riskThemeIds(risk).includes('other')).length;

  // Document names (filenames only)
  const docNames = (data.source_documents || [])
    .map(d => d.split('/').pop().split('\\').pop())
    .join(', ') || 'Unknown';

  // Evaluation stays in its optional appendix.
  const evalBadgeClass = data.eval?.pass ? 'report-bg-success-strong' : 'report-bg-danger-strong';
  const evalBadgeText = data.eval?.pass ? 'PASS' : 'FAIL';

  // Max timing for bar widths
  const timings = data.retrieval_stats?.timing_ms || {};
  const maxTiming = Math.max(...Object.values(timings), 1);

  // Full-report distributions never change when the findings are filtered.
  const riskCount = data.risks.length;
  const taxonomyCounts = new Map();
  const groundingCounts = new Map(['high', 'medium', 'low', 'ungrounded'].map(level => [level, 0]));
  for (const risk of data.risks) {
    const taxonomy = typeof risk.taxonomy === 'string' && risk.taxonomy.length ? risk.taxonomy : '__asago_no_taxonomy__';
    const grounding = typeof risk.grounding_confidence === 'string' && risk.grounding_confidence.length
      ? risk.grounding_confidence : 'unknown';
    taxonomyCounts.set(taxonomy, (taxonomyCounts.get(taxonomy) || 0) + 1);
    groundingCounts.set(grounding, (groundingCounts.get(grounding) || 0) + 1);
  }
  const taxonomyDistribution = [...taxonomyCounts].map(([value, count]) => ({ value, count }))
    .sort((a, b) => b.count - a.count || a.value.localeCompare(b.value));
  const groundingDistribution = [...groundingCounts].map(([value, count]) => ({ value, count }));
  const taxonomyCount = [...taxonomyCounts.keys()].filter(value => value !== '__asago_no_taxonomy__').length;
  const highCount = groundingCounts.get('high') || 0;
  const reviewCount = ['medium', 'low', 'ungrounded'].reduce((sum, level) => sum + (groundingCounts.get(level) || 0), 0);

  return {
    data,
    docNames,
    evalBadgeClass,
    evalBadgeText,
    maxTiming,
    riskCount,
    taxonomyCount,
    highCount,
    reviewCount,
    taxonomyDistribution,
    groundingDistribution,
    themeDistribution,
    themeMax: Math.max(...themeDistribution.map(item => item.count), 1),
    riskThemeIds,
    taxonomyMax: Math.max(...taxonomyDistribution.map(item => item.count), 1),
    sortBy: 'grounding_confidence',
    sortDesc: true,
    filterAcceptedBy: [],
    filterGrounding: [],
    filterTaxonomy: [],
    filterThemes: [],
    searchQuery: '',
    findingColumns: [
      { key: 'risk_name', label: 'Risk' },
      { key: 'taxonomy', label: 'Taxonomy' },
      { key: 'grounding_confidence', label: 'Grounding confidence' },
      { key: 'evidence_count', label: 'Evidence' },
    ],
    processingStats: [
      { key: 'total_chunks', label: 'Chunks processed' },
      { key: 'total_candidates_retrieved', label: 'Candidates retrieved' },
      { key: 'auto_accepted', label: 'Auto-accepted candidates' },
      { key: 'llm_judged', label: 'Candidates judged' },
      { key: 'grounding_filtered', label: 'Filtered during grounding' },
    ],

    get summaryText() {
      if (!riskCount) return 'No risk matches were recorded in this analysis. Processing details are available below.';
      const entries = riskCount === 1 ? 'risk entry' : 'risk entries';
      const scope = taxonomyCount
        ? ' across ' + taxonomyCount + (taxonomyCount === 1 ? ' taxonomy.' : ' taxonomies.')
        : '. Taxonomy information was not recorded.';
      return 'This analysis mapped document passages to ' + riskCount + ' ' + entries + scope;
    },

    get visibleRisks() {
      return this.filteredRisks(data.risks, this.filterAcceptedBy, this.filterGrounding, this.filterTaxonomy, this.searchQuery, this.filterThemes);
    },

    get themeCoverageText() {
      return `${groupedCount} of ${riskCount} matches grouped by theme · ${riskCount - groupedCount} not yet grouped`;
    },

    themeLabel(id) {
      return (themeById.get(id) || otherTheme).label;
    },

    get themeFilterLabel() {
      if (!this.filterThemes.length || this.filterThemes.length === themeDistribution.length) return 'All';
      if (this.filterThemes.length === 1) return this.themeLabel(this.filterThemes[0]);
      return `${this.filterThemes.length} selected`;
    },

    get hasActiveFilters() {
      return this.filterAcceptedBy.length > 0 || this.filterGrounding.length > 0
        || this.filterTaxonomy.length > 0 || this.filterThemes.length > 0 || this.searchQuery.trim().length > 0;
    },

    resetFilters() {
      this.filterAcceptedBy = [];
      this.filterGrounding = [];
      this.filterTaxonomy = [];
      this.filterThemes = [];
      this.searchQuery = '';
    },

    toggleChartFilter(field, value) {
      this[field] = this[field].includes(value)
        ? this[field].filter(item => item !== value)
        : [...this[field], value];
    },

    showReviewMatches() {
      this.resetFilters();
      this.filterGrounding = ['medium', 'low', 'ungrounded'];
      this.sortBy = 'grounding_confidence';
      this.sortDesc = false;
      this.scrollToFindings();
    },

    scrollToFindings() {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.getElementById('findings')?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
      document.getElementById('findings-heading')?.focus({ preventScroll: true });
    },

    formatDate(value) {
      if (!value) return '';
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? value : date.toLocaleString(undefined, {
        year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit',
      });
    },

    formatPercent(value) {
      return typeof value === 'number' && Number.isFinite(value)
        ? (value * 100).toFixed(1).replace(/\.0$/, '') + '%' : '—';
    },

    matchShare(count) {
      return this.formatPercent(riskCount ? count / riskCount : 0);
    },

    groundingValue(value) {
      return typeof value === 'string' && value.length ? value : 'unknown';
    },

    groundingBarColor(value) {
      return {
        high: 'asago-grounding-high',
        medium: 'asago-grounding-medium',
        low: 'asago-grounding-low',
        ungrounded: 'report-bg-muted-strong',
      }[value] || 'report-bg-muted-strong';
    },

    taxonomyColor(value) {
      return {
        'ibm-risk-atlas': 'report-bg-brand pf-v6-u-text-color-link',
        'credo-ucf': 'report-bg-success pf-v6-u-text-color-status-success',
        'mit-ai-risk-repository': 'report-bg-custom pf-v6-u-text-color-status-custom',
        'ai-risk-taxonomy': 'report-bg-warning pf-v6-u-text-color-status-warning',
        'air-2024': 'report-bg-danger pf-v6-u-text-color-status-danger',
      }[value] || 'report-bg-secondary pf-v6-u-text-color-regular';
    },

    fileName(path) {
      if (!path) return '?';
      return path.split('/').pop().split('\\').pop();
    },

    groundingColor(level) {
      const colors = {
        'high': 'asago-grounding-badge',
        'medium': 'report-bg-warning pf-v6-u-text-color-status-warning',
        'low': 'report-bg-warning pf-v6-u-text-color-status-warning',
        'ungrounded': 'report-bg-secondary pf-v6-u-text-color-subtle',
      };
      return colors[level] || 'report-bg-secondary pf-v6-u-text-color-subtle';
    },

    groundingOptions(risks) {
      const values = [...new Set((risks || [])
        .map(risk => this.groundingValue(risk.grounding_confidence))
        .filter(value => typeof value === 'string' && value.length > 0))];
      const commonOrder = ['high', 'medium', 'low', 'ungrounded'];
      return [
        ...commonOrder,
        ...values.filter(value => !commonOrder.includes(value)).sort(),
      ];
    },

    groundingLabel(value) {
      if (typeof value !== 'string' || value.length === 0) return 'Unknown';
      const labels = {
        high: 'High',
        medium: 'Medium',
        low: 'Low',
        ungrounded: 'Ungrounded',
      };
      return labels[value] || value.replace(/_/g, ' ').replace(/\b\w/g, letter => letter.toUpperCase());
    },

    groundingFilterLabel(selected, risks) {
      const count = (selected || []).length;
      const optionCount = this.groundingOptions(risks).length;
      if (count === 0 || count === optionCount) return 'All';
      if (count === 1) return this.groundingLabel(selected[0]);
      return `${count} selected`;
    },

    taxonomyFilterValue(taxonomy) {
      return typeof taxonomy === 'string' && taxonomy.length > 0 ? taxonomy : '__asago_no_taxonomy__';
    },

    taxonomyOptions(risks) {
      const values = [...new Set((risks || [])
        .map(risk => this.taxonomyFilterValue(risk.taxonomy)))];
      return values.sort((a, b) => {
        if (a === '__asago_no_taxonomy__') return 1;
        if (b === '__asago_no_taxonomy__') return -1;
        return a.localeCompare(b);
      });
    },

    taxonomyLabel(value) {
      return value === '__asago_no_taxonomy__' ? 'No taxonomy' : value;
    },

    taxonomyFilterLabel(selected, risks) {
      const count = (selected || []).length;
      const optionCount = this.taxonomyOptions(risks).length;
      if (count === 0 || count === optionCount) return 'All';
      if (count === 1) return this.taxonomyLabel(selected[0]);
      return `${count} selected`;
    },

    acceptedByOptions(risks) {
      const values = [...new Set((risks || [])
        .map(risk => risk.accepted_by)
        .filter(value => typeof value === 'string' && value.length > 0))];
      const commonOrder = ['threshold', 'llm_judge', 'rrf', 'auto_promoted', 'expansion'];
      return [
        ...commonOrder,
        ...values.filter(value => !commonOrder.includes(value)).sort(),
      ];
    },

    acceptedByLabel(value) {
      if (typeof value !== 'string' || value.length === 0) return 'Unknown';
      const labels = {
        threshold: 'Threshold',
        llm_judge: 'LLM Judge',
        rrf: 'RRF',
        auto_promoted: 'Auto Promoted',
        expansion: 'Expansion',
      };
      return labels[value] || value.replace(/_/g, ' ').replace(/\b\w/g, letter => letter.toUpperCase());
    },

    acceptedByFilterLabel(selected, risks) {
      const count = (selected || []).length;
      const optionCount = this.acceptedByOptions(risks).length;
      if (count === 0 || count === optionCount) return 'All';
      if (count === 1) return this.acceptedByLabel(selected[0]);
      return `${count} selected`;
    },

    acceptedByColor(value) {
      const colors = {
        threshold: 'report-bg-success pf-v6-u-text-color-status-success',
        llm_judge: 'report-bg-warning pf-v6-u-text-color-status-warning',
        rrf: 'report-bg-brand pf-v6-u-text-color-link',
        auto_promoted: 'report-bg-custom pf-v6-u-text-color-status-custom',
        expansion: 'report-bg-custom pf-v6-u-text-color-status-custom',
      };
      return colors[value] || 'report-bg-secondary pf-v6-u-text-color-regular';
    },

    filteredRisks(risks, acceptedBy, grounding, taxonomy, query, themes) {
      let result = risks || [];
      if ((acceptedBy || []).length > 0) {
        const selected = new Set(acceptedBy);
        result = result.filter(r => selected.has(r.accepted_by));
      }
      if ((grounding || []).length > 0) {
        const selectedGrounding = new Set(grounding);
        result = result.filter(r => selectedGrounding.has(this.groundingValue(r.grounding_confidence)));
      }
      if ((taxonomy || []).length > 0) {
        const selectedTaxonomy = new Set(taxonomy);
        result = result.filter(r => selectedTaxonomy.has(this.taxonomyFilterValue(r.taxonomy)));
      }
      if ((themes || []).length > 0) {
        const selectedThemes = new Set(themes);
        result = result.filter(r => riskThemeIds(r).some(id => selectedThemes.has(id)));
      }
      if (query && query.trim()) {
        const q = query.trim().toLowerCase();
        result = result.filter(r =>
          (r.risk_name || '').toLowerCase().includes(q) ||
          (r.risk_id || '').toLowerCase().includes(q)
        );
      }
      return result;
    },

    sortedRisks(risks, sortBy, sortDesc) {
      const sorted = [...risks].sort((a, b) => {
        let va, vb;
        if (sortBy === 'evidence_count') {
          va = (a.evidence || []).length;
          vb = (b.evidence || []).length;
        } else if (sortBy === 'grounding_confidence') {
          const order = { high: 3, medium: 2, low: 1, ungrounded: 0 };
          va = order[a.grounding_confidence] ?? -1;
          vb = order[b.grounding_confidence] ?? -1;
          if (va === vb) return (a.risk_name || '').localeCompare(b.risk_name || '');
        } else if (sortBy === 'taxonomy') {
          va = this.taxonomyLabel(this.taxonomyFilterValue(a.taxonomy));
          vb = this.taxonomyLabel(this.taxonomyFilterValue(b.taxonomy));
        } else {
          va = a[sortBy];
          vb = b[sortBy];
        }
        if (va == null && vb == null) return 0;
        if (va == null) return 1;
        if (vb == null) return -1;
        if (typeof va === 'string') {
          const cmp = va.localeCompare(vb);
          return sortDesc ? -cmp : cmp;
        }
        return sortDesc ? vb - va : va - vb;
      });
      return sorted;
    },

    toggleSort(field) {
      const section = this;
      if (section.sortBy === field) {
        section.sortDesc = !section.sortDesc;
      } else {
        section.sortBy = field;
        section.sortDesc = field === 'grounding_confidence' || field === 'evidence_count';
      }
    },

    scoreBreakdown(risk) {
      const scores = risk.scores || {};
      const metadata = data.metadata || {};
      const colbert = Boolean(metadata.colbert_model);
      const expansion = risk.accepted_by === 'expansion';
      const definitions = [
        {
          key: 'bm25_rank', label: 'Keyword rank (BM25)',
          description: 'Where this risk appeared in the keyword search results.',
          direction: 'Lower is better', range: '1 upwards',
          interpretation: '1 is the top keyword result. Rank is relative to the other risks in that search.',
        },
        {
          key: 'embedding_distance', label: 'Meaning distance (embeddings)',
          description: 'Compares the meaning of the search text and the risk description.',
          direction: 'Lower is closer', range: '0–2',
          interpretation: '0 is the closest possible match according to the model. Useful cutoffs depend on the embedding model.',
        },
        {
          key: 'cross_encoder_score',
          label: colbert ? 'Token similarity (ColBERT)' : 'Relevance score (cross-encoder)',
          description: colbert
            ? 'Matches individual tokens in the search text against the risk description.'
            : 'A model’s score for how relevant a passage is to this risk.',
          direction: 'Higher is stronger', range: '0–1',
          interpretation: colbert
            ? 'Uses normalized token similarity. Its scale differs from a cross-encoder score.'
            : 'Interpretation depends on the reranker model. There is no universal “good” cutoff across models.',
        },
        {
          key: 'rrf_score', label: 'Combined ranking (RRF)',
          description: 'Combines positions in the keyword and meaning-based search lists.',
          direction: 'Higher is better', range: '0–0.0328 (default)',
          interpretation: 'The default maximum is reached when a risk ranks first in both search lists. Small values are expected.',
        },
      ];
      return definitions.map(definition => {
        const raw = scores[definition.key];
        const result = { ...definition, value: this.formatRetrievalScore(raw) };
        if (!Number.isFinite(raw)) {
          result.interpretation = 'No value was recorded for this score.';
        } else if (expansion && raw === 0) {
          result.value = 'Not used';
          result.interpretation = 'This risk was added by checking related risks. The saved zero is a placeholder.';
        } else if (definition.key === 'bm25_rank') {
          result.value = raw === 0 ? 'Not ranked' : String(raw);
          if (raw === 0) result.interpretation = 'This risk did not appear in the keyword shortlist. Zero is a placeholder for an absent rank.';
        } else if (definition.key === 'embedding_distance' && raw === 0) {
          if (colbert) {
            result.value = 'Not used';
            result.interpretation = 'ColBERT uses token similarity instead of a single embedding distance. The saved zero is a placeholder.';
          } else {
            result.interpretation = 'A stored zero can mean an exact match between embeddings or an unrecorded default. This saved result does not distinguish them.';
          }
        } else if (definition.key === 'cross_encoder_score' && raw === 0) {
          if (colbert) {
            result.value = 'Not ranked';
            result.interpretation = 'This risk did not appear in the ColBERT shortlist. The saved zero is a placeholder.';
          } else if (metadata.use_cross_encoder === false || metadata.cross_encoder_model === null) {
            result.value = 'Not run';
            result.interpretation = 'Cross-encoder reranking was disabled for this run. The saved zero is a placeholder.';
          } else if (metadata.query_gen === true) {
            result.interpretation = 'Generated-query retrieval can skip reranking, while fallback retrieval can run it. This zero may be a placeholder or a scored result.';
          } else if (metadata.bm25_rescue_rank > 0 && scores.bm25_rank > 0 && scores.bm25_rank <= metadata.bm25_rescue_rank) {
            result.interpretation = 'Keyword rescue can retain a risk without a reranker score. This zero may be a placeholder or a scored result.';
          } else if (metadata.use_cross_encoder !== true || metadata.query_gen !== false) {
            result.interpretation = 'The saved settings do not confirm whether reranking ran for this match. This zero may be a placeholder.';
          }
        } else if (definition.key === 'rrf_score' && raw === 0) {
          result.value = 'Not recorded';
          result.interpretation = 'RRF is positive when a risk appears in either search list. No combined ranking was recorded here.';
        }
        return result;
      });
    },

    formatRetrievalScore(value) {
      if (!Number.isFinite(value)) return 'Not recorded';
      // Keep tiny measured scores distinguishable from zero placeholders.
      return value !== 0 && Math.abs(value) < 0.0001 ? value.toExponential(2) : value.toFixed(4);
    },

    riskCalls(riskId) {
      return (data.llm_calls || []).filter(c =>
        (c.risk_ids || []).includes(riskId)
      );
    },

    isExpandableMetadata(value) {
      return value !== null && typeof value === 'object' && Object.keys(value).length > 0;
    },

    metadataValueLabel(value) {
      if (value == null) return 'Not set';
      if (Array.isArray(value)) {
        return value.length ? value.length + (value.length === 1 ? ' item' : ' items') : 'Empty list []';
      }
      if (typeof value === 'object') {
        const count = Object.keys(value).length;
        return count ? count + (count === 1 ? ' field' : ' fields') : 'Empty object {}';
      }
      return value === '' ? 'Empty string ""' : String(value);
    },

    formatJSON(obj) {
      if (obj == null) return '';
      if (typeof obj === 'string') return obj;
      try {
        return JSON.stringify(obj, null, 2);
      } catch {
        return String(obj);
      }
    },

    sortedTimings() {
      return Object.entries(timings).sort((a, b) => b[1] - a[1]);
    },

    formatNumber(n) {
      if (n == null) return '?';
      return n.toLocaleString();
    },
  };
}
</script>
<script>{{ alpine_js | safe }}</script>
<script>
(() => {
  const tooltip = document.createElement('div');
  tooltip.id = 'report-hover-tooltip';
  tooltip.className = 'report-hover-tooltip';
  tooltip.setAttribute('role', 'tooltip');
  tooltip.hidden = true;
  document.body.append(tooltip);

  let active = null;
  let describedElement = null;
  let previousDescription = null;
  let openedByFocus = false;
  const padding = 12;
  const gap = 8;

  function hide() {
    if (describedElement) {
      if (previousDescription === null) describedElement.removeAttribute('aria-describedby');
      else describedElement.setAttribute('aria-describedby', previousDescription);
    }
    active = null;
    describedElement = null;
    tooltip.hidden = true;
  }

  function place() {
    if (!active || !active.isConnected) { hide(); return; }
    const target = active.getBoundingClientRect();
    if (target.bottom < 0 || target.top > window.innerHeight) { hide(); return; }
    const box = tooltip.getBoundingClientRect();
    const left = Math.max(padding, Math.min(
      target.left + (target.width - box.width) / 2,
      document.documentElement.clientWidth - box.width - padding
    ));
    let top = target.bottom + gap;
    if (top + box.height > window.innerHeight - padding && target.top - box.height - gap >= padding) {
      top = target.top - box.height - gap;
    }
    top = Math.max(padding, Math.min(top, window.innerHeight - box.height - padding));
    tooltip.style.left = `${Math.round(left)}px`;
    tooltip.style.top = `${Math.round(top)}px`;
  }

  function show(target, fromFocus = false) {
    const message = target.getAttribute('data-tip')?.trim();
    if (!message) { hide(); return; }
    const descriptionTarget = fromFocus ? target.closest('button') || target : target;
    if (active !== target || describedElement !== descriptionTarget) {
      hide();
      active = target;
      describedElement = descriptionTarget;
      previousDescription = descriptionTarget.getAttribute('aria-describedby');
      descriptionTarget.setAttribute('aria-describedby', tooltip.id);
    }
    openedByFocus = fromFocus;
    tooltip.textContent = message;
    tooltip.hidden = false;
    place();
  }

  document.addEventListener('pointerover', event => {
    const target = event.target instanceof Element ? event.target.closest('[data-tip]') : null;
    if (target) show(target);
  });
  document.addEventListener('pointerout', event => {
    if (!active || openedByFocus || !(event.target instanceof Node) || !active.contains(event.target)) return;
    if (!(event.relatedTarget instanceof Node) || !active.contains(event.relatedTarget)) hide();
  });
  document.addEventListener('focusin', event => {
    if (!(event.target instanceof Element)) return;
    const target = event.target.matches('[data-tip]')
      ? event.target : event.target.querySelector('[data-tip]');
    if (target) show(target, true);
  });
  document.addEventListener('focusout', () => { if (openedByFocus) hide(); });
  document.addEventListener('click', event => {
    const target = event.target instanceof Element ? event.target.closest('[data-tip]') : null;
    if (target) { show(target); requestAnimationFrame(place); }
    else hide();
  });
  document.addEventListener('keydown', event => { if (event.key === 'Escape') hide(); });
  document.addEventListener('scroll', place, true);
  window.addEventListener('resize', place);
})();
</script>
