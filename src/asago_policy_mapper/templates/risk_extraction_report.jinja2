              <span x-text="taxonomyFilterLabel(filterTaxonomy, data.risks)"></span>
              <span aria-hidden="true" class="pf-v6-u-ml-xs pf-v6-u-text-color-subtle">&#9662;</span>
            </button>
            <div x-show="taxonomyOpen" x-transition
                 class="report-absolute report-left-0 report-top-full report-z-30 pf-v6-u-mt-xs report-w-64 report-max-h-64 report-overflow-y-auto report-rounded report-border report-border-default report-bg-primary pf-v6-u-p-xs pf-v6-u-box-shadow-lg"
                 role="group" aria-label="Taxonomy">
              <label class="pf-v6-u-display-flex report-cursor-pointer pf-v6-u-align-items-center report-gap-2 report-rounded pf-v6-u-px-sm report-py-one-half pf-v6-u-font-size-xs report-hover-bg-secondary">
                <input type="checkbox" :checked="filterTaxonomy.length === 0 || filterTaxonomy.length === taxonomyOptions(data.risks).length"
                       @change="filterTaxonomy = []" class="report-rounded report-border-default" />
                <span>All</span>
              </label>
              <div class="pf-v6-u-my-xs report-border-t report-border-default"></div>
              <template x-for="option in taxonomyOptions(data.risks)" :key="option">
                <label class="pf-v6-u-display-flex report-cursor-pointer pf-v6-u-align-items-center report-gap-2 report-rounded pf-v6-u-px-sm report-py-one-half pf-v6-u-font-size-xs report-hover-bg-secondary">
                  <input type="checkbox" :value="option" x-model="filterTaxonomy"
                         class="report-rounded report-border-default" />
                  <span x-text="taxonomyLabel(option)"></span>
                </label>
