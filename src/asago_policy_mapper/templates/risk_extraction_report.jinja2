          <div class="report-relative" x-data="{ taxonomyOpen: false }" @keydown.escape.stop.prevent="taxonomyOpen = false; $refs.taxonomyButton.focus()" @click.outside="taxonomyOpen = false">
            <button type="button" x-ref="taxonomyButton" aria-label="Filter by taxonomy" @click="taxonomyOpen = !taxonomyOpen"
